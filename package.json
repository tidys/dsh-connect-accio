{
  "name": "dsh-connect-accio",
  "displayName": "DSH Connect Accio",
  "description": "把本机已登录的 Accio 模型接入 DeepSeek Harness：复用本机凭据，提供实时模型目录、工具调用、账号与积分详情。",
  "version": "0.2.0",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "accio",
    "model-provider",
    "credits"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "icons/accio-128.png",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icons",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.1"
  }
}
